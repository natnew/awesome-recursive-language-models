{
  "name": "awesome-recursive-language-models",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling for the awesome-recursive-language-models curated list: markdown formatting, linting, and link validation.",
  "license": "CC0-1.0",
  "scripts": {
    "build": "prettier --check .",
    "format": "prettier --write .",
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "lint:awesome": "awesome-lint README.md",
    "lint:docs": "remark README.md AGENTS.md CLAUDE.md CONTRIBUTING.md SECURITY.md",
    "test": "linkinator README.md --markdown --skip \"github.com/natnew/awesome-recursive-language-models\""
  },
  "remarkConfig": {
    "plugins": [
      "remark-mdx",
      "remark-preset-lint-recommended"
    ]
  },
  "devDependencies": {
    "awesome-lint": "^2.3.0",
    "linkinator": "^8.0.2",
    "markdownlint-cli2": "^0.23.1",
    "remark-cli": "^12.0.1",
    "remark-mdx": "^3.1.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "prettier": "^3.9.6"
  }
}
